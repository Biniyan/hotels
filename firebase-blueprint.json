{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents registered customer profile at Shankar Restaurant",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Customer display name" },
        "email": { "type": "string", "description": "Customer email" },
        "photoURL": { "type": "string", "description": "User avatar" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "savedAddresses": { "type": "array", "description": "List of saved delivery addresses" },
        "loyaltyPoints": { "type": "number", "description": "Shankar Club rewards points" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["uid", "name"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer food order record with dish line-items and status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Order ID" },
        "orderNumber": { "type": "string", "description": "Human readable order number like SHK-748920" },
        "userId": { "type": "string", "description": "Customer user ID" },
        "customerName": { "type": "string", "description": "Customer name" },
        "customerPhone": { "type": "string", "description": "Contact phone" },
        "customerEmail": { "type": "string", "description": "Optional email" },
        "bookingType": { "type": "string", "enum": ["delivery", "dine_in", "takeaway"] },
        "items": { "type": "array", "description": "Ordered food items" },
        "subtotal": { "type": "number" },
        "gstAmount": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "discountAmount": { "type": "number" },
        "discountCode": { "type": "string" },
        "grandTotal": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["upi", "card", "cod", "pay_at_counter"] },
        "paymentStatus": { "type": "string", "enum": ["paid", "pending"] },
        "orderStatus": { "type": "string", "enum": ["placed", "confirmed", "cooking", "out_for_delivery", "ready_at_table", "completed"] },
        "createdAt": { "type": "string" },
        "estimatedDeliveryMinutes": { "type": "number" },
        "deliveryAddress": { "type": "string" },
        "tableNumber": { "type": "string" },
        "geofenceDistanceKm": { "type": "number" }
      },
      "required": ["id", "orderNumber", "userId", "bookingType", "grandTotal", "orderStatus"]
    },
    "TableReservation": {
      "title": "TableReservation",
      "description": "Dine-in table booking reservation at Shankar Restaurant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "guestName": { "type": "string" },
        "guestPhone": { "type": "string" },
        "guestsCount": { "type": "number" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "seatingArea": { "type": "string" },
        "specialRequests": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "guestName", "guestsCount", "date", "timeSlot"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile documents"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer restaurant food orders"
    },
    "/reservations/{reservationId}": {
      "schema": { "$ref": "#/entities/TableReservation" },
      "description": "Table bookings in dining halls"
    }
  }
}
